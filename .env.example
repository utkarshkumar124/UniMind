# ==============================================================================
# UniMind - Environment Configuration Template
# Copy this file to .env and adjust values for local development.
# ==============================================================================

# Application Configuration
PROJECT_NAME="UniMind Knowledge Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (JSON array of allowed origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Data & Knowledge Base Paths
DATA_RAW_DIR="data/raw"
DATA_PROCESSED_DIR="data/processed"
DATA_EVALUATION_DIR="data/evaluation"
VECTOR_STORE_DIR="vector_store"

# Embedding Model Configuration (Provisional: Sentence Transformers)
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# LLM Configuration (Google Gemini API - Phase 3)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

